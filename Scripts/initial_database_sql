
/*
===============================================================

Create Database and Schemas

===============================================================
Script Purpose:
	This scrpt creates a new database named 'DataWarehouse' after checking if it already exists.
	If the database exists, it is droprd and recreated. Additionaly, the script set up tree schemas
	within the database: 'broze', 'silver', 'gold'.

WARNING:
	Running this script will drop the entire 'DataWarehouse if it exist.
	All data in the database will be permanently deleted. Proceed with caution.
	and ensure you have backup befor running this script.

*/


USE master;
GO

-- Drop and reteate the 'DataWarehouse' database
IF EXISTS(SELECT 1 FROM sys.databases WHERE name = 'DataWarehouse')
BEGIN
	ALTER DATABASE Datawarehouse SET SINGLE_USER With ROLLBACK IMMEDIATE;
	DROP DATABASE DataWarehouse;
END;
GO

--Create Database 'DataWarehouse'

CREATE DATABASE DataWarehouse;
GO

USE DataWarehouse;
GO

--Create Schema
CREATE SCHEMA bronze;
GO
CREATE SCHEMA silver;
GO
CREATE SCHEMA gold;
GO
